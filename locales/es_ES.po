# --- Status / informational --------------------------------------

msgid "Ticket #%d — version %d"
msgstr "Ticket nº %d — versión %d"

msgid "Review the report before signing:"
msgstr "Revise el informe antes de firmar:"

msgid "No report generated yet for this ticket."
msgstr "Aún no se ha generado ningún informe para este ticket."

msgid "Only the assigned technician or their supervisor can generate the report."
msgstr "Solo el técnico asignado o su responsable pueden generar el informe."

msgid "Your profile does not have access to ticket reports."
msgstr "Su perfil no tiene acceso a los informes de tickets."

msgid "This ticket is closed. Existing reports can still be downloaded and signed, but no new versions can be generated."
msgstr "Este ticket está cerrado. Los informes existentes pueden descargarse y firmarse, pero no se pueden generar nuevas versiones."

msgid "Closed tickets cannot have new report versions."
msgstr "Los tickets cerrados no admiten nuevas versiones del informe."

# --- Email body --------------------------------------------------

msgid "Sign report for ticket #%d"
msgstr "Firmar el informe del ticket nº %d"

msgid "You have been asked to sign a service report."
msgstr "Se le ha solicitado firmar un informe de servicio."

msgid "This link is single-use and expires in 7 days."
msgstr "Este enlace es de un solo uso y caduca a los 7 días."

# --- Permissions / profile ---------------------------------------

msgid "Plugin access"
msgstr "Acceso al complemento"

msgid "Edit document styles"
msgstr "Editar estilos del documento"

msgid "You do not have permission to edit profile rights."
msgstr "No tiene permiso para editar los permisos del perfil."

msgid "Permissions updated."
msgstr "Permisos actualizados."

msgid "Invalid profile."
msgstr "Perfil no válido."

# --- Document styles screen --------------------------------------

msgid "Ticket report styles"
msgstr "Estilos del informe de ticket"

msgid "Document styles"
msgstr "Estilos del documento"

msgid "Customize the header, footer, colours, disclaimer and draft retention used when generating ticket report PDFs."
msgstr "Personalice la cabecera, el pie, los colores, el aviso legal y la retención de borradores usados al generar los PDF de los informes."

msgid "Live preview (approximate)"
msgstr "Vista previa en vivo (aproximada)"

msgid "Not saved — for reference only"
msgstr "No se guarda — solo de referencia"

msgid "Rough mockup of the PDF header, section bars, disclaimer and footer, updated live as you edit the fields on the left. It is an HTML approximation, not a pixel-perfect match — the real PDF is drawn by FPDF, with different fonts and spacing."
msgstr "Boceto aproximado de la cabecera, las barras de sección, el aviso legal y el pie del PDF, que se actualiza en vivo mientras edita los campos de la izquierda. Es una aproximación en HTML, no una réplica exacta — el PDF real lo dibuja FPDF, con fuentes y espaciados distintos."

msgid "Nº TICKET"
msgstr "Nº TICKET"

msgid "Preview not available for this path — the real PDF will still use it."
msgstr "Vista previa no disponible para esta ruta — el PDF real igual la usará."

msgid "Header — company info"
msgstr "Cabecera — datos de la empresa"

msgid "Where should the header values come from?"
msgstr "¿De dónde deben tomarse los valores de la cabecera?"

msgid "From the ticket entity (recommended) — name, NIT, address, website are read from Setup > Entities."
msgstr "Desde la entidad del ticket (recomendado): el nombre, NIF, dirección y sitio web se leen en Configurar > Entidades."

msgid "Use the custom values below for every report."
msgstr "Usar los valores personalizados de abajo en todos los informes."

msgid "Company name"
msgstr "Nombre de la empresa"

msgid "Tax ID (NIT)"
msgstr "NIF / identificador fiscal"

msgid "Address"
msgstr "Dirección"

msgid "Website"
msgstr "Sitio web"

msgid "Logo filename"
msgstr "Nombre del archivo del logo"

msgid "Resolved against the plugin's pics/ folder. Drop your PNG there. (Used regardless of source.)"
msgstr "Se resuelve en la carpeta pics/ del complemento. Coloque su PNG allí. (Se utiliza con cualquier origen.)"

msgid "These values appear on every report. None of them are read from the GLPI database — edit them here."
msgstr "Estos valores aparecen en todos los informes. Ninguno se lee de la base de datos de GLPI; edítelos aquí."

msgid "Logo"
msgstr "Logo"

msgid "Path to the logo image, relative to the GLPI installation root. Pick one of the logos already present in your GLPI install, or type a custom path."
msgstr "Ruta al archivo del logo, relativa a la raíz de la instalación de GLPI. Elija uno de los logos ya presentes en su GLPI o introduzca una ruta personalizada."

msgid "Pick from existing GLPI logos"
msgstr "Elegir de los logos existentes de GLPI"

msgid "— choose to copy into the path field —"
msgstr "— elija para copiar en el campo de ruta —"

msgid "Logo path"
msgstr "Ruta del logo"

msgid "Colours"
msgstr "Colores"

msgid "Section header background"
msgstr "Fondo de las cabeceras de sección"

msgid "Ticket ID colour (header)"
msgstr "Color del nº de ticket (cabecera)"

msgid "Disclaimer block"
msgstr "Bloque de aviso legal"

msgid "Printed on its own page near the end of every report, right after the signature block. Leave the body empty to omit this section entirely."
msgstr "Se imprime en su propia página cerca del final de cada informe, justo después del bloque de firmas. Deje el contenido vacío para omitir esta sección por completo."

msgid "Title"
msgstr "Título"

msgid "Short heading printed in the grey section bar above the body — e.g. your policy's name (\"CUSTOMER-INDUCED DAMAGE\", \"LIMITED WARRANTY TERMS\"...)."
msgstr "Encabezado corto que se imprime en la barra gris de sección, encima del contenido — p. ej. el nombre de su política («DAÑO INDUCIDO POR EL CLIENTE», «TÉRMINOS DE GARANTÍA LIMITADA»...)."

msgid "Body"
msgstr "Contenido"

msgid "Full legal text of your warranty/liability disclaimer, printed as-is (line breaks are kept). This plugin ships with no default wording — write (or paste) your own; it is only ever saved here, in your database, never in the plugin's code."
msgstr "Texto legal completo de su aviso de garantía/responsabilidad, que se imprime tal cual (se conservan los saltos de línea). Este complemento no trae un texto predeterminado: escriba (o pegue) el suyo; solo se guarda aquí, en su base de datos, nunca en el código del complemento."

msgid "Footer & retention"
msgstr "Pie y retención"

msgid "Footer text"
msgstr "Texto del pie"

msgid "Placeholders: {page} = current page, {pages} = total pages."
msgstr "Comodines: {page} = página actual, {pages} = páginas totales."

msgid "Draft retention (days)"
msgstr "Retención de borradores (días)"

msgid "Unsigned drafts older than this many days are deleted by the daily cron."
msgstr "Los borradores sin firmar con más antigüedad que este número de días se eliminan en la tarea diaria."

msgid "Your profile only has read access to these settings."
msgstr "Su perfil solo tiene acceso de lectura a esta configuración."

msgid "Document styles saved."
msgstr "Estilos del documento guardados."

msgid "Ticket Report & Sign"
msgstr "Ticket Report & Sign"

# --- Toast messages from form handlers ---------------------------

msgid "Report generated."
msgstr "Informe generado."

msgid "Failed to generate report:"
msgstr "No se ha podido generar el informe:"

msgid "Report not found"
msgstr "Informe no encontrado"

msgid "Document missing"
msgstr "Falta el documento"

msgid "File missing on disk"
msgstr "Falta el archivo en disco"

msgid "Ticket not found"
msgstr "Ticket no encontrado"

msgid "Missing ticket id"
msgstr "Falta el identificador del ticket"

msgid "Missing signature side."
msgstr "Falta indicar qué firma se está guardando."

msgid "No technician signature received."
msgstr "No se ha recibido la firma del técnico."

msgid "No client signature received."
msgstr "No se ha recibido la firma del cliente."

msgid "Technician signature saved."
msgstr "Firma del técnico guardada."

msgid "Client signature saved."
msgstr "Firma del cliente guardada."

msgid "Failed to save signature:"
msgstr "No se ha podido guardar la firma:"

msgid "Cannot generate a report on a closed ticket."
msgstr "No se puede generar un informe sobre un ticket cerrado."

msgid "You are not authorized to generate the report for this ticket."
msgstr "No tiene autorización para generar el informe de este ticket."

msgid "Your profile does not have permission to generate reports."
msgstr "Su perfil no tiene permiso para generar informes."

msgid "Your profile does not have permission to sign reports."
msgstr "Su perfil no tiene permiso para firmar informes."

msgid "Your profile does not have permission to send signing emails."
msgstr "Su perfil no tiene permiso para enviar correos de firma."

msgid "Invalid email address."
msgstr "Dirección de correo no válida."

msgid "Signing link sent."
msgstr "Enlace de firma enviado."

msgid "Failed to send email:"
msgstr "No se ha podido enviar el correo:"

# --- Cron --------------------------------------------------------

msgid "Ticket Report & Sign: clean abandoned drafts"
msgstr "Ticket Report & Sign: limpiar borradores abandonados"

msgid "Remove draft reports (no signatures) older than 15 days, including their PDF on disk."
msgstr "Eliminar los informes en borrador (sin firmas) con más de 15 días, incluido su PDF en disco."

